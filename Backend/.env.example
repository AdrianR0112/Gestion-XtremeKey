# Marca como 'expirada' cada suscripcion activa cuyo vencimiento ya paso.
# Viene habilitado por defecto: no envia mensajes ni consume APIs de pago, solo
# corrige un estado que ya es incorrecto. Corre a las 00:10 (America/Guayaquil).
EXPIRACION_ENABLED=true
EXPIRACION_CRON=10 0 * * *
EXPIRACION_DRY_RUN=false
